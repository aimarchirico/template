{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "check": {
      "cache": true,
      "inputs": [
        "src/**/*",
        "eslint.config.mjs",
        "tsconfig.json",
        "package.json"
      ]
    },
    "fix": {
      "cache": false
    }
  },
  "boundaries": {
    "tags": {
      "type:app": {
        "dependencies": {
          "allow": ["feature", "shared"]
        }
      },
      "type:feature": {
        "dependencies": {
          "allow": ["shared"]
        }
      },
      "type:shared": {
        "dependencies": {
          "allow": ["shared"]
        }
      }
    }
  }
}
