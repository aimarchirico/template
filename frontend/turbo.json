{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": true
    },
    "check": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "fix": {
      "cache": false
    }
  },
  "boundaries": {
    "tags": {
      "app": {
        "dependencies": {
          "allow": ["feature", "shared"]
        }
      },
      "feature": {
        "dependencies": {
          "allow": ["shared"]
        }
      },
      "shared": {
        "dependencies": {
          "allow": ["shared"]
        }
      }
    }
  }
}
