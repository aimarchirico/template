{
  "name": "expo",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "check": "eslint . --no-error-on-unmatched-pattern && tsc",
    "fix": "eslint . --no-error-on-unmatched-pattern --fix",
    "dev": "expo start --dev-client",
    "prebuild": "expo prebuild --platform android",
    "build:debug": "cd android && bash gradlew assembleDebug",
    "build:release": "cd android && bash gradlew assembleRelease",
    "export": "expo export --platform web",
    "cloudflare:fix": "node scripts/fix-cloudflare.js"
  },
  "dependencies": {
    "api-client": "workspace:*",
    "expo": "~56.0.11",
    "expo-constants": "~57.0.2",
    "expo-dev-client": "~57.0.4",
    "expo-linking": "~57.0.1",
    "expo-router": "~56.2.10",
    "expo-splash-screen": "~57.0.1",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-css-interop": "0.2.6",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@aimarchirico/commons-expo": "^1.1.0",
    "@aimarchirico/commons-ts": "^1.1.0",
    "@babel/core": "^8.0.1",
    "@types/node": "^26.0.1",
    "@types/react": "~19.2.14",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.2",
    "replace-in-file": "^8.4.0",
    "shelljs": "^0.10.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "private": true
}
