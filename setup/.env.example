# Infrastructure constants
# Copied per project on purpose, so any project can diverge from the defaults.
CLOUDFLARE_ACCOUNT_ID="id"
CLOUDFLARE_ZONE_ID="id"
BASE_DOMAIN="example.com"

# Public hostname this project's API is reached on. The tunnel route is keyed
# by hostname, so each project needs its own.
API_HOST="myapp-api.example.com"

# Existing Cloudflare Tunnel the VPS runs, shared by every project.
TUNNEL_ID="id"

# Existing Access policy the shared API application uses. List the account's
# policies to find it:
#   gh api --hostname api.cloudflare.com  # or:
#   curl -H "Authorization: Bearer $CLOUDFLARE_SETUP_TOKEN" \
#     https://api.cloudflare.com/client/v4/accounts/$CLOUDFLARE_ACCOUNT_ID/access/policies
ACCESS_POLICY_ID="id"

# VPS the API is deployed to.
VPS_HOST="localhost"
VPS_USER="user"

# Path to the private key for VPS_USER. Its contents are pushed as the
# VPS_SSH_KEY secret; the file itself never leaves this machine.
VPS_SSH_KEY_FILE="/home/user/.ssh/id_ed25519"

# Cloudflare token setup uses locally.
# Scopes: Account · Cloudflare Pages:Edit, Account · Cloudflare Tunnel:Edit,
#         Account · Access: Apps and Policies:Edit, Zone · DNS:Edit.
CLOUDFLARE_SETUP_TOKEN="token"

# Cloudflare token pushed to web-production for deployments, where it is named
# CLOUDFLARE_API_TOKEN. Scopes: Account · Cloudflare Pages:Edit only.
CLOUDFLARE_DEPLOY_TOKEN="token"

# Credentials that cannot be minted by setup. EXPO_TOKEN also stores and reads
# back the Android keystore, so it needs access to the EAS project's account.
GH_PACKAGES_TOKEN="token"
EXPO_TOKEN="token"
