# Everything here is pushed to GitHub by `task setup`, grouped by the
# environment it belongs to. The trailing note gives each value's scope and
# origin:
#   setup/.env:  supplied by the maintainer
#   config.json: derived from the project configuration
#   command:     produced by a provisioning command and chained onward

# api-production
VPS_USER="user"                       # variable · setup/.env
VPS_HOST="vps.example.com"            # variable · setup/.env
VPS_SSH_KEY="key"                     # secret · contents of VPS_SSH_KEY_FILE

# android-production
ANDROID_KEY_ALIAS="alias"             # variable · command import-keystore
ANDROID_KEYSTORE_BASE64="base64_string" # secret · command import-keystore
ANDROID_KEYSTORE_PASSWORD="password"  # secret · command import-keystore
ANDROID_KEY_PASSWORD="password"       # secret · command import-keystore

# web-production
APP_URL="https://slug.example.com"    # variable · config.json + BASE_DOMAIN
CLOUDFLARE_ACCOUNT_ID="id"            # variable · setup/.env
CLOUDFLARE_API_TOKEN="token"          # secret · setup/.env CLOUDFLARE_DEPLOY_TOKEN

# Repository
API_URL="https://slug.example.com/api" # variable · APP_URL, proxied path
CF_ACCESS_CLIENT_ID="id"              # variable · command create-service-token
CF_ACCESS_CLIENT_SECRET="secret"      # secret · command create-service-token
GH_PACKAGES_TOKEN="token"             # secret · setup/.env
