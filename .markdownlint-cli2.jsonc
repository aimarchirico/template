{
  "config": {
    "default": true,
    "MD013": false,
    "MD033": false,
    "MD041": false
  },
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.expo/**",
    "**/.git/**",
    "backend/**/build/**",
    "backend/**/.gradle/**",
    "**/tmp/**"
  ]
}
