# Database
DB_HOST=localhost:5432
DB_USER=postgres
DB_PASSWORD=postgres

# Local web dev: allow the Expo web dev server (Metro) through CORS.
# Comma-separate multiple origins. Leave unset to disable CORS entirely.
CLIENT_CORS_ALLOWED_ORIGINS=http://localhost:8081

# Reverse-proxy secret. Set by the Cloudflare proxy in production; leave
# blank locally so ProxyValidationFilter is bypassed (browser preflight
# requests cannot send the X-Proxy-Secret header).
PROXY_SECRET=
